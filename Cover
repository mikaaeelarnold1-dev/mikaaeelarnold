<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Mikaaeel Arnold — Author, Poet &amp; Novelist</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Cinzel+Decorative:wght@400;700&family=Cinzel:wght@400;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#0b0b10;--gold:#f6d98b;--gold2:#c9a24d;--red:#8a0d12;--silver:#e9ecf3;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-behavior:smooth;scroll-padding-top:60px;background:var(--bg)}
*{box-sizing:border-box}
body{margin:0;background:radial-gradient(ellipse at 50% 20%,#1a1a22 0%,var(--bg) 60%);color:var(--gold);font-family:'Cinzel',Georgia,serif;overflow-x:hidden;position:relative}
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:5;display:flex;justify-content:center;flex-wrap:wrap;gap:6px 22px;padding:14px 12px;background:rgba(11,11,16,.3);backdrop-filter:blur(3px);border-bottom:1px solid rgba(201,162,77,.15)}
nav a{color:var(--gold2);text-decoration:none;letter-spacing:.08em;font-size:14px}
nav a:hover{color:var(--gold)}
section{position:relative;text-align:center;padding:70px 22px;max-width:760px;margin:0 auto;z-index:2}
#hero{padding-top:60px;min-height:80vh}
h1{font-family:'Cinzel Decorative',Georgia,serif;font-weight:400;font-size:clamp(44px,13vw,92px);line-height:1;margin:.2em 0;color:var(--gold);text-shadow:0 0 12px rgba(246,217,139,.7),0 0 36px rgba(246,217,139,.35)}
h2{font-weight:400;letter-spacing:.06em;font-size:clamp(28px,7vw,44px);margin:0 0 24px;text-shadow:0 0 14px rgba(246,217,139,.5)}
.tag{font-size:clamp(16px,4.5vw,24px);letter-spacing:.08em;margin:18px 0 34px}
.btn{display:block;width:min(340px,86%);margin:14px auto;padding:15px 20px;border-radius:40px;text-decoration:none;font-size:17px;letter-spacing:.06em;color:#f8ecd0;border:2px solid var(--gold2)}
.b1{background:linear-gradient(#b3121a,#6d080c);box-shadow:0 0 22px rgba(190,20,30,.6)}
.b2{color:var(--gold);background:#000;border-color:var(--gold);box-shadow:0 0 6px var(--gold),0 0 16px rgba(246,217,139,.55),inset 0 0 8px rgba(246,217,139,.3)}
p{line-height:1.8;color:#e6cf9a;font-size:16px}
.cards{display:grid;gap:18px}
.card{border:2px solid var(--gold);border-radius:14px;padding:24px 18px;background:#000;box-shadow:0 0 6px var(--gold),0 0 20px rgba(246,217,139,.5),inset 0 0 10px rgba(246,217,139,.25)}
.card h3{margin:0 0 10px;font-weight:600;font-size:20px;color:var(--gold)}
.card .btn{width:auto;display:inline-block;margin:6px 4px;padding:9px 16px;font-size:14px}
.soon{font-style:italic;opacity:.75}
footer{position:relative;z-index:2;text-align:center;padding:30px 10px 50px}
.soc a{display:inline-flex;width:38px;height:38px;margin:0 7px;border-radius:50%;background:var(--gold2);align-items:center;justify-content:center}
.soc svg{width:20px;height:20px;fill:none;stroke:#0b0b10;stroke-width:2}
small{display:block;margin-top:18px;color:var(--gold2);font-size:12px;letter-spacing:.08em}
.rose{position:absolute;z-index:1;pointer-events:none;filter:drop-shadow(0 0 2px #fff) drop-shadow(0 0 8px rgba(200,220,255,.85))}
.vine{filter:drop-shadow(0 0 3px #fff) drop-shadow(0 0 9px rgba(190,210,255,.7));position:absolute;top:70px;z-index:1;pointer-events:none;width:90px;height:620px}
.web{position:absolute;top:0;width:175px;height:175px;z-index:1;pointer-events:none;opacity:.9;filter:drop-shadow(0 0 2px rgba(220,230,255,.9))}
.spider{position:absolute;top:0;left:64px;z-index:1;width:36px;height:200px;pointer-events:none;transform-origin:50% 0;animation:sw 5s ease-in-out infinite;filter:drop-shadow(0 0 4px rgba(255,40,40,.5))}
@keyframes sw{0%,100%{transform:rotate(-3deg)}50%{transform:rotate(3deg)}}
@media(prefers-reduced-motion:reduce){.spider{animation:none}}
@media(min-width:700px){.vine{width:150px}}
.petals{position:fixed;inset:0;z-index:1;pointer-events:none;overflow:hidden}
.hall{position:fixed;inset:0;z-index:0;pointer-events:none;background:#030305}
.hall svg{width:100%;height:100%;display:block}
.fl{animation:fl 3.2s ease-in-out infinite}
@keyframes fl{0%,100%{opacity:.85}30%{opacity:.5}60%{opacity:1}80%{opacity:.65}}
.fog{animation:fg 22s ease-in-out infinite alternate}
@keyframes fg{from{transform:translateX(-40px)}to{transform:translateX(40px)}}
@media(prefers-reduced-motion:reduce){.fl,.fog{animation:none}}
#books,#poetry,#blog,#contact{min-height:70vh;padding-top:90px}
.back{display:inline-block;margin-bottom:22px;color:var(--gold2);text-decoration:none;letter-spacing:.1em;font-size:14px}
.ic{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:2;stroke-linejoin:round;stroke-linecap:round}
.book{display:flex;flex-wrap:wrap;gap:18px;align-items:flex-start;justify-content:center;text-align:left}
.cover{width:140px;height:200px;border-radius:4px 10px 10px 4px;border:2px solid var(--gold);background:linear-gradient(160deg,#2a0508,#0a0a10 70%);box-shadow:0 0 14px rgba(246,217,139,.4);display:flex;align-items:flex-end;justify-content:center;padding:10px;position:relative;overflow:hidden;flex:none}
.cover svg{position:absolute;top:14px;left:25px;width:90px;height:90px;filter:drop-shadow(0 0 4px #fff)}
.cover span{position:relative;font-family:'Cinzel Decorative',serif;font-size:13px;text-align:center;line-height:1.3;color:var(--gold)}
.cover.pic{height:auto;width:150px;padding:0}
.cover.pic img{width:100%;display:block}
.promo{display:flex;flex-wrap:wrap;gap:20px;align-items:center;justify-content:center;margin:0 0 26px;padding:22px 18px;border-radius:14px;border:2px solid var(--gold);background:linear-gradient(135deg,#2a0508,#000 70%);box-shadow:0 0 6px var(--gold),0 0 20px rgba(246,217,139,.5),inset 0 0 10px rgba(246,217,139,.25);text-align:left}
.promo .pi{flex:1 1 210px;min-width:210px}
.badge{display:inline-block;font-size:11px;letter-spacing:.14em;padding:4px 10px;border-radius:20px;background:var(--red);color:#fff;border:1px solid var(--gold2)}
.promo h3{margin:10px 0 6px;font-weight:600;font-size:22px;color:var(--gold);text-shadow:0 0 10px rgba(246,217,139,.5)}
.price{font-size:15px;letter-spacing:.08em;color:#e6cf9a}
.price b{font-family:'Cinzel Decorative',Georgia,serif;font-size:34px;font-weight:700;color:#fff;text-shadow:0 0 6px var(--gold),0 0 16px rgba(246,217,139,.7);margin-left:6px}
.promo ul{list-style:none;padding:0;margin:10px 0;line-height:1.9;font-size:15px;color:#e6cf9a}
.promo svg.ph{flex:none;width:96px;height:190px;filter:drop-shadow(0 0 8px rgba(246,217,139,.5))}
.cover.dim{opacity:.5}
.binfo{flex:1 1 200px;min-width:200px}
.meta{list-style:none;padding:0;margin:10px 0;font-size:14px;line-height:1.9;color:#e6cf9a}
.meta b{color:var(--gold);font-weight:600}
.card .btn.buy{display:inline-flex;align-items:center;gap:8px;margin-left:0}
.chips a{font-size:12px;color:var(--gold2);margin-right:12px;letter-spacing:.06em}
.post{text-align:left}
.verse{font-style:italic;font-size:17px}
.act{display:flex;gap:10px;margin-top:14px}
.like,.cbtn{display:inline-flex;align-items:center;gap:6px;background:transparent;border:1px solid rgba(246,217,139,.5);color:var(--gold);border-radius:20px;padding:6px 14px;font:inherit;font-size:14px;cursor:pointer}
.like.on{color:#ff6b7a;border-color:#ff6b7a}
.like.on .ic{fill:currentColor}
.post header{display:flex;align-items:center;gap:10px;margin-bottom:10px}
.av{width:40px;height:40px;border-radius:50%;border:2px solid var(--gold);display:flex;align-items:center;justify-content:center;font-family:'Cinzel Decorative',serif;background:#14101f}
.who b{display:block;font-size:15px}
.who i{font-size:12px;opacity:.7;font-style:normal}
.cm{margin-top:12px;border-top:1px solid rgba(246,217,139,.25);padding-top:10px}
.cmt{padding:6px 10px;margin:6px 0;border-radius:10px;background:#14101f;font-size:14px;color:#e6cf9a}
.cm input{width:100%;margin:8px 0;padding:10px 12px;border-radius:10px;border:1px solid var(--gold2);background:#0b0b10;color:var(--gold);font:inherit;font-size:14px}
.cm button{padding:8px 18px;border-radius:20px;border:1px solid var(--gold);background:#000;color:var(--gold);font:inherit;cursor:pointer}
.pre{margin-top:14px;text-align:left}
.nt{margin:0 0 22px}
.nbtn{display:inline-flex;align-items:center;gap:8px;background:#000;border:1.5px solid var(--gold);color:var(--gold);border-radius:24px;padding:9px 18px;font:inherit;font-size:14px;cursor:pointer;box-shadow:0 0 6px var(--gold),0 0 14px rgba(246,217,139,.4)}
.nt .pre{max-width:360px;margin:12px auto 0;background:#000;border:1px solid var(--gold2);border-radius:12px;padding:6px 16px 14px}
.pre label{display:block;font-size:13px;letter-spacing:.06em;margin-top:10px}
.pre input,.pre select{width:100%;margin-top:4px;padding:10px 12px;border-radius:10px;border:1px solid var(--gold2);background:#0b0b10;color:var(--gold);font:inherit;font-size:14px}
.pre button{font:inherit;cursor:pointer;margin-top:16px}
.tipb{display:inline-flex;align-items:center;gap:6px;border:1px solid var(--gold);color:var(--gold);border-radius:20px;padding:6px 14px;font:inherit;font-size:14px;text-decoration:none;box-shadow:0 0 6px rgba(246,217,139,.5)}
.note{background:rgba(255,255,255,.12);-webkit-backdrop-filter:blur(10px);backdrop-filter:blur(10px);border:1.5px solid rgba(246,217,139,.7);border-radius:14px;padding:16px 18px;text-align:left;margin:-8px auto 24px;max-width:560px;box-shadow:0 0 10px rgba(246,217,139,.35)}
.note h4{margin:0 0 8px;letter-spacing:.12em;font-size:14px;color:var(--gold);font-weight:600}
.note p{margin:6px 0;color:#fff;font-size:14px;line-height:1.7}
.note .ic{vertical-align:-4px;color:var(--gold)}
.sub{font-style:italic;margin:-4px 0 10px;opacity:.9}
.cw{display:inline-block;font-size:12px;letter-spacing:.06em;border:1px solid rgba(255,255,255,.55);border-radius:8px;padding:4px 10px;margin:0 0 10px}
#poetry .card .sub,#poetry .card .cw{color:#fff}
#poetry .card{background:#000;color:#fff}
#poetry .card h3,#poetry .card .verse{color:#fff;text-shadow:0 0 4px #fff,0 0 10px rgba(200,220,255,.85)}
#poetry .like{color:#fff;border-color:#fff;box-shadow:0 0 6px rgba(255,255,255,.5)}
#poetry .like.on{color:#ff6b7a;border-color:#ff6b7a;box-shadow:0 0 8px rgba(255,107,122,.6)}
.pt{position:absolute;top:-30px;width:16px;height:20px;animation:fall linear infinite;filter:drop-shadow(0 0 3px #fff)}
.pt svg{width:100%;height:100%;fill:#150f2b;stroke:#fff;stroke-width:1.2}
@keyframes fall{0%{transform:translate(0,-30px) rotate(0) scale(var(--sc))}50%{transform:translate(var(--dx),55vh) rotate(180deg) scale(var(--sc))}100%{transform:translate(calc(var(--dx)*-1),115vh) rotate(360deg) scale(var(--sc))}}
</style>
</head>
